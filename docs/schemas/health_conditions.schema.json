{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterlife.game/schemas/health_conditions.schema.json",
  "title": "Health conditions",
  "description": "Illness and injury types. The Life Stages task adds duration and effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conditions"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "descKey"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "nameKey": {
            "$ref": "#/$defs/id"
          },
          "descKey": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
