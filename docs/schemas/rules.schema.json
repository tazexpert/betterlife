{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterlife.game/schemas/rules.schema.json",
  "title": "Rules",
  "description": "Conditions and effects shared by all content types. Reference checks (ids exist, stats are stored, flag kinds, min <= max) are enforced by the C# rule parser.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "op": {
      "enum": [
        "==",
        "!=",
        "<",
        "<=",
        ">",
        ">="
      ]
    },
    "range": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      ]
    },
    "nonNegativeRange": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "statRange": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "conditions"
          ],
          "properties": {
            "type": {
              "const": "all"
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "conditions"
          ],
          "properties": {
            "type": {
              "const": "any"
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ],
          "properties": {
            "type": {
              "const": "not"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "stat",
            "op",
            "value"
          ],
          "properties": {
            "type": {
              "const": "stat"
            },
            "stat": {
              "$ref": "#/$defs/id"
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "flag"
          ],
          "properties": {
            "type": {
              "const": "flag"
            },
            "flag": {
              "$ref": "#/$defs/id"
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "dependentRequired": {
            "op": [
              "value"
            ],
            "value": [
              "op"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "trait"
          ],
          "properties": {
            "type": {
              "const": "trait"
            },
            "trait": {
              "$ref": "#/$defs/id"
            },
            "revealed": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "skill",
            "op",
            "value"
          ],
          "properties": {
            "type": {
              "const": "skill"
            },
            "skill": {
              "$ref": "#/$defs/id"
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "op",
            "value"
          ],
          "properties": {
            "type": {
              "const": "age"
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "op",
            "value"
          ],
          "properties": {
            "type": {
              "const": "year"
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "op",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "cash"
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "amount": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "domain",
            "op",
            "value"
          ],
          "properties": {
            "type": {
              "const": "reputation"
            },
            "domain": {
              "$ref": "#/$defs/id"
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ],
          "properties": {
            "type": {
              "const": "healthCondition"
            },
            "condition": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "area",
            "op",
            "value"
          ],
          "properties": {
            "type": {
              "const": "fortune"
            },
            "area": {
              "enum": [
                "finance",
                "love",
                "health",
                "career",
                "study"
              ]
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "kind",
            "op",
            "value"
          ],
          "properties": {
            "type": {
              "const": "karma"
            },
            "kind": {
              "enum": [
                "good",
                "bad"
              ]
            },
            "op": {
              "$ref": "#/$defs/op"
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "anyOf": [
            {
              "required": [
                "country"
              ]
            },
            {
              "required": [
                "city"
              ]
            }
          ],
          "properties": {
            "type": {
              "const": "location"
            },
            "country": {
              "$ref": "#/$defs/id"
            },
            "city": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "background"
          ],
          "properties": {
            "type": {
              "const": "familyBackground"
            },
            "background": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "stat",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "stat"
            },
            "stat": {
              "$ref": "#/$defs/id"
            },
            "amount": {
              "$ref": "#/$defs/range"
            },
            "source": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "cash"
            },
            "amount": {
              "$ref": "#/$defs/range"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "flag"
          ],
          "properties": {
            "type": {
              "const": "flag.set"
            },
            "flag": {
              "$ref": "#/$defs/id"
            },
            "expiryWeeks": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "flag"
          ],
          "properties": {
            "type": {
              "const": "flag.clear"
            },
            "flag": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "flag"
          ],
          "properties": {
            "type": {
              "const": "flag.increment"
            },
            "flag": {
              "$ref": "#/$defs/id"
            },
            "amount": {
              "type": "integer",
              "minimum": 1
            },
            "expiryWeeks": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "trait"
          ],
          "properties": {
            "type": {
              "const": "trait.add"
            },
            "trait": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "trait"
          ],
          "properties": {
            "type": {
              "const": "trait.remove"
            },
            "trait": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "trait"
          ],
          "properties": {
            "type": {
              "const": "trait.reveal"
            },
            "trait": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "skill",
            "gain"
          ],
          "properties": {
            "type": {
              "const": "skill.practice"
            },
            "skill": {
              "$ref": "#/$defs/id"
            },
            "gain": {
              "$ref": "#/$defs/nonNegativeRange"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "domain",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "reputation"
            },
            "domain": {
              "$ref": "#/$defs/id"
            },
            "amount": {
              "$ref": "#/$defs/range"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "condition",
            "severity"
          ],
          "properties": {
            "type": {
              "const": "healthCondition.add"
            },
            "condition": {
              "$ref": "#/$defs/id"
            },
            "severity": {
              "$ref": "#/$defs/statRange"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ],
          "properties": {
            "type": {
              "const": "healthCondition.remove"
            },
            "condition": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "condition",
            "then"
          ],
          "properties": {
            "type": {
              "const": "if"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            },
            "then": {
              "$ref": "#/$defs/effects"
            },
            "else": {
              "$ref": "#/$defs/effects"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "karma.good"
            },
            "amount": {
              "$ref": "#/$defs/nonNegativeRange"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "karma.bad"
            },
            "amount": {
              "$ref": "#/$defs/nonNegativeRange"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "karma.merit"
            },
            "amount": {
              "$ref": "#/$defs/nonNegativeRange"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "event",
            "delayWeeks"
          ],
          "properties": {
            "type": {
              "const": "event.schedule"
            },
            "event": {
              "$ref": "#/$defs/id"
            },
            "delayWeeks": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "chance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base"
      ],
      "properties": {
        "base": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stat",
              "weight"
            ],
            "properties": {
              "stat": {
                "$ref": "#/$defs/id"
              },
              "weight": {
                "type": "number"
              }
            }
          }
        },
        "fortune": {
          "enum": [
            "finance",
            "love",
            "health",
            "career",
            "study"
          ]
        },
        "karma": {
          "type": "boolean"
        }
      }
    }
  }
}
