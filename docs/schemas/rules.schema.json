          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "career.fire"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "relation",
            "amount"
          ],
          "properties": {
            "type": {
              "const": "relationship"
            },
