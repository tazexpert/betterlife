{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterlife.game/schemas/education_programs.schema.json",
  "title": "Education programs",
  "description": "Levels of schooling (rank 1 kindergarten … 8 doctorate; equivalent programs share a rank) and the institutions offering them. Dependents are enrolled automatically in autoEnroll programs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "programs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "rank",
          "years",
          "entryAge",
          "requiresRank",
          "compulsory",
          "autoEnroll",
          "weeklyHours",
          "skills",
          "institutions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "nameKey": {
            "$ref": "#/$defs/id"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "years": {
            "type": "integer",
            "minimum": 1
          },
          "entryAge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "requiresRank": {
            "type": "integer",
            "minimum": 0
          },
          "compulsory": {
            "type": "boolean"
          },
          "autoEnroll": {
            "type": "boolean"
          },
          "weeklyHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 168
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/skill"
            }
          },
          "institutions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "nameKey",
                "prestige",
                "tuitionPerYear",
                "difficulty",
                "quality",
                "familyMinIncome"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "nameKey": {
                  "$ref": "#/$defs/id"
                },
                "prestige": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "tuitionPerYear": {
                  "type": "number",
                  "minimum": 0
                },
                "difficulty": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "quality": {
                  "type": "number"
                },
                "familyMinIncome": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "gainPerHour"
      ],
      "properties": {
        "skill": {
          "$ref": "#/$defs/id"
        },
        "gainPerHour": {
          "type": "number"
        },
        "maxHours": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    }
  }
}
