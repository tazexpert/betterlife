{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterlife.game/schemas/astrology.schema.json",
  "title": "Astrology",
  "description": "Thai astrology tables. The loader checks 12 signs with distinct start days, all 8 birth days and 12 year animals with known elements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseFortune",
    "cycle",
    "yearlyNoise",
    "yearAnimalAnchorYear",
    "zodiacSigns",
    "birthDays",
    "elements",
    "yearAnimals"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finance": {
          "type": "number"
        },
        "love": {
          "type": "number"
        },
        "health": {
          "type": "number"
        },
        "career": {
          "type": "number"
        },
        "study": {
          "type": "number"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "baseFortune": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodYears",
        "amplitude",
        "areaPhaseYears"
      ],
      "properties": {
        "periodYears": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "amplitude": {
          "type": "number",
          "minimum": 0
        },
        "areaPhaseYears": {
          "$ref": "#/$defs/modifiers"
        }
      }
    },
    "yearlyNoise": {
      "type": "number",
      "minimum": 0
    },
    "yearAnimalAnchorYear": {
      "type": "integer"
    },
    "zodiacSigns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "startMonth",
          "startDay",
          "modifiers"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "nameKey": {
            "$ref": "#/$defs/id"
          },
          "startMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "startDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "modifiers": {
            "$ref": "#/$defs/modifiers"
          }
        }
      }
    },
    "birthDays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "nameKey",
          "modifiers"
        ],
        "properties": {
          "day": {
            "enum": [
              "sunday",
              "monday",
              "tuesday",
              "wednesday",
              "wednesday_night",
              "thursday",
              "friday",
              "saturday"
            ]
          },
          "nameKey": {
            "$ref": "#/$defs/id"
          },
          "modifiers": {
            "$ref": "#/$defs/modifiers"
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "modifiers"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "nameKey": {
            "$ref": "#/$defs/id"
          },
          "modifiers": {
            "$ref": "#/$defs/modifiers"
          }
        }
      }
    },
    "yearAnimals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "element"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "nameKey": {
            "$ref": "#/$defs/id"
          },
          "element": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
