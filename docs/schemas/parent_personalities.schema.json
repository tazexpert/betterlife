{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterlife.game/schemas/parent_personalities.schema.json",
  "title": "Parent personalities",
  "description": "Parenting styles and their effect on the child at birth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "personalities"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "personalities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "weight",
          "statModifiers",
          "traitChances"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "nameKey": {
            "$ref": "#/$defs/id"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "statModifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stat",
                "amount"
              ],
              "properties": {
                "stat": {
                  "$ref": "#/$defs/id"
                },
                "amount": {
                  "type": "number"
                }
              }
            }
          },
          "traitChances": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "trait",
                "chance"
              ],
              "properties": {
                "trait": {
                  "$ref": "#/$defs/id"
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
