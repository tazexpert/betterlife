{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterlife.game/schemas/creation_settings.schema.json",
  "title": "Creation settings",
  "description": "Ranges used when creating a life. Exactly one file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "birthYear",
    "parentAgeAtBirth"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "birthYear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1926
        },
        "max": {
          "type": "integer",
          "minimum": 1926
        }
      }
    },
    "parentAgeAtBirth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
