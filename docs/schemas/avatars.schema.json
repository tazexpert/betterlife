{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterlife.game/schemas/avatars.schema.json",
  "title": "Avatar pictures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceRoot",
    "bands",
    "faces"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "resourceRoot": {
      "type": "string",
      "minLength": 1
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minAge",
          "maxAge",
          "filePrefix"
        ],
        "properties": {
          "minAge": {
            "type": "integer",
            "minimum": 0
          },
          "maxAge": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "filePrefix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "faces": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sex"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "sex": {
            "enum": [
              "female",
              "male"
            ]
          }
        }
      }
    }
  }
}
