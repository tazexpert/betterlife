{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betterlife.game/schemas/careers.schema.json",
  "title": "Careers",
  "description": "Career ladders. premium careers are deeper but never better paid than normal careers of the same category (checked by tests).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tracks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "category",
          "premium",
          "requirement",
          "hiring",
          "weeklyHours",
          "performanceSkill",
          "skills",
          "stressPerHour",
          "incomeVolatility",
          "marketBeta",
          "layoffSensitivity",
          "pensionRate",
          "risk",
          "levels"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "nameKey": {
            "$ref": "#/$defs/id"
          },
          "category": {
            "enum": [
              "corporate",
              "government",
              "freelance",
              "business",
              "high_risk",
              "illegal",
              "labor"
            ]
          },
          "premium": {
            "type": "boolean"
          },
          "requirement": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "rules.schema.json#/$defs/condition"
              }
            ]
          },
          "hiring": {
            "$ref": "rules.schema.json#/$defs/chance"
          },
          "weeklyHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 168
          },
          "performanceSkill": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/id"
              }
            ]
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill",
                "gainPerHour"
              ],
              "properties": {
                "skill": {
                  "$ref": "#/$defs/id"
                },
                "gainPerHour": {
                  "type": "number"
                },
                "maxHours": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "stressPerHour": {
            "type": "number",
            "minimum": 0
          },
          "incomeVolatility": {
            "type": "number",
            "minimum": 0
          },
          "marketBeta": {
            "type": "number"
          },
          "layoffSensitivity": {
            "type": "number",
            "minimum": 0
          },
          "pensionRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "risk": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "monthlyChance",
                  "endsJob",
                  "reasonKey",
                  "effects"
                ],
                "properties": {
                  "monthlyChance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "endsJob": {
                    "type": "boolean"
                  },
                  "reasonKey": {
                    "$ref": "#/$defs/id"
                  },
                  "effects": {
                    "$ref": "rules.schema.json#/$defs/effects"
                  }
                }
              }
            ]
          },
          "levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "titleKey",
                "monthlySalary",
                "promotionAfterMonths",
                "promotionPerformance"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "titleKey": {
                  "$ref": "#/$defs/id"
                },
                "monthlySalary": {
                  "type": "number",
                  "minimum": 0
                },
                "promotionAfterMonths": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "promotionPerformance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    }
  }
}
