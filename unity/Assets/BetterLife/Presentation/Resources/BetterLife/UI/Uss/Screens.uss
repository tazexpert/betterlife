/* Screens of task 16: dashboard, inbox, event dialog, breakdown. Values come from Theme.uss. */
.section-title {
    margin-top: var(--space-m);
    margin-bottom: var(--space-xs);
    font-size: var(--font-m);
    color: var(--color-text-muted);
    -unity-font-style: bold;
}

/* Dashboard */
.dashboard__inbox {
    height: var(--touch-height);
    margin: 0 0 var(--space-s) 0;
    font-size: var(--font-m);
    color: var(--color-bg);
    background-color: var(--color-warning);
    border-width: 0;
    border-radius: var(--radius-s);
}

.dashboard__hint {
    margin-top: var(--space-xs);
    font-size: var(--font-s);
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
}

.stat-card {
    margin-bottom: var(--space-s);
    padding: var(--space-s) var(--space-m);
    background-color: var(--color-surface);
    border-radius: var(--radius-m);
    border-left-width: 8px;
    border-left-color: var(--color-border);
    color: var(--color-text-muted);
}

.stat-card--improving {
    border-left-color: var(--color-good);
    color: var(--color-good);
}

.stat-card--worsening {
    border-left-color: var(--color-bad);
    color: var(--color-bad);
}

.stat-card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.stat-card__name {
    font-size: var(--font-m);
    color: var(--color-text);
}

.stat-card__value {
    font-size: var(--font-xl);
    color: var(--color-text);
    -unity-font-style: bold;
}

.stat-card__delta {
    font-size: var(--font-s);
    -unity-text-align: middle-right;
}

.stat-card__sparkline {
    height: var(--sparkline-height);
    margin-top: var(--space-xs);
}

.habit-card {
    margin-bottom: var(--space-xs);
    padding: var(--space-s) var(--space-m);
    background-color: var(--color-surface);
    border-radius: var(--radius-s);
    border-left-width: 8px;
    border-left-color: var(--color-bad);
}

.habit-card--quitting {
    border-left-color: var(--color-warning);
}

.habit-card__name {
    font-size: var(--font-m);
    color: var(--color-text);
}

.habit-card__status {
    font-size: var(--font-s);
    color: var(--color-text-muted);
}

/* Inbox */
.inbox-item {
    margin-bottom: var(--space-xs);
    padding: var(--space-s) var(--space-m);
    background-color: var(--color-surface);
    border-radius: var(--radius-s);
    border-left-width: 8px;
    border-left-color: var(--color-border);
}

.inbox-item--decision {
    border-left-color: var(--color-primary);
}

.inbox-item--major {
    border-left-color: var(--color-warning);
}

.inbox-item--urgent {
    border-left-color: var(--color-bad);
}

.inbox-item__title {
    font-size: var(--font-m);
    color: var(--color-text);
    white-space: normal;
}

.inbox-item__subtitle {
    font-size: var(--font-s);
    color: var(--color-text-muted);
}

.inbox__empty {
    margin-top: var(--space-l);
    font-size: var(--font-m);
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Dialogs (modal layer children) */
.dialog {
    max-height: var(--dialog-max-height);
    padding: var(--space-m);
    background-color: var(--color-surface);
    border-radius: var(--radius-m);
}

.dialog__scroll {
    flex-shrink: 1;
}

.dialog__title {
    font-size: var(--font-l);
    color: var(--color-text);
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: var(--space-s);
}

.dialog__body {
    font-size: var(--font-m);
    color: var(--color-text);
    white-space: normal;
    margin-bottom: var(--space-s);
}

.dialog__note {
    font-size: var(--font-s);
    color: var(--color-text-muted);
    white-space: normal;
    margin-bottom: var(--space-s);
}

.dialog__primary {
    height: var(--touch-height);
    margin: var(--space-s) 0 0 0;
    font-size: var(--font-m);
    color: var(--color-bg);
    background-color: var(--color-primary);
    border-width: 0;
    border-radius: var(--radius-s);
}

.dialog__secondary {
    height: var(--touch-height);
    margin: var(--space-s) 0 0 0;
    font-size: var(--font-m);
    color: var(--color-text);
    background-color: var(--color-surface-raised);
    border-width: 0;
    border-radius: var(--radius-s);
}

.event-choice {
    margin-bottom: var(--space-s);
    padding: var(--space-s);
    background-color: var(--color-surface-raised);
    border-radius: var(--radius-s);
}

.event-choice__button {
    min-height: var(--touch-height);
    margin: 0 0 var(--space-xs) 0;
    font-size: var(--font-m);
    color: var(--color-bg);
    background-color: var(--color-primary);
    border-width: 0;
    border-radius: var(--radius-s);
    white-space: normal;
}

.event-choice__button:disabled {
    opacity: 0.4;
}

.event-choice__chance {
    font-size: var(--font-s);
    color: var(--color-warning);
}

.event-choice__locked {
    font-size: var(--font-s);
    color: var(--color-bad);
}

.event-choice__effect {
    font-size: var(--font-s);
    color: var(--color-text);
    white-space: normal;
}

.event-choice__fail-title {
    margin-top: var(--space-xs);
    font-size: var(--font-s);
    color: var(--color-text-muted);
}

.event-dialog__result {
    display: none;
}

.event-dialog__result-line {
    font-size: var(--font-m);
    color: var(--color-good);
}

.event-dialog__result--failed .event-dialog__result-line {
    color: var(--color-bad);
}

/* Breakdown */
.breakdown__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.breakdown__value {
    font-size: var(--font-xl);
    color: var(--color-text);
    -unity-font-style: bold;
}

.breakdown-line {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-xs) 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.breakdown-line__text {
    flex-shrink: 1;
}

.breakdown-line__label {
    font-size: var(--font-m);
    color: var(--color-text);
    white-space: normal;
}

.breakdown-line__detail {
    font-size: var(--font-s);
    color: var(--color-text-muted);
}

.breakdown-line__value {
    font-size: var(--font-m);
    color: var(--color-text-muted);
    -unity-font-style: bold;
}

.breakdown-line--positive .breakdown-line__value {
    color: var(--color-good);
}

.breakdown-line--negative .breakdown-line__value {
    color: var(--color-bad);
}

/* List screens of task 17 (Money, People, Person, More, Astrology, Timeline) */
.list-screen__subtitle {
    font-size: var(--font-s);
    color: var(--color-text-muted);
    white-space: normal;
    margin-bottom: var(--space-s);
}

.list-screen__empty {
    font-size: var(--font-s);
    color: var(--color-text-muted);
    white-space: normal;
    margin-bottom: var(--space-xs);
}

.value-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: var(--touch-height);
    padding: var(--space-xs) var(--space-s);
    margin-bottom: 4px;
    background-color: var(--color-surface);
    border-radius: var(--radius-s);
}

.value-row__text {
    flex-shrink: 1;
    flex-grow: 1;
    margin-right: var(--space-s);
}

.value-row__label {
    font-size: var(--font-m);
    color: var(--color-text);
    white-space: normal;
}

.value-row__detail {
    font-size: var(--font-s);
    color: var(--color-text-muted);
    white-space: normal;
}

.value-row__value {
    font-size: var(--font-m);
    color: var(--color-text);
    -unity-font-style: bold;
}

.value-row--good .value-row__value {
    color: var(--color-good);
}

.value-row--bad .value-row__value {
    color: var(--color-bad);
}

.value-row--tappable {
    border-right-width: 6px;
    border-right-color: var(--color-surface-raised);
}

.value-row--tappable:active {
    background-color: var(--color-surface-raised);
}

.value-row--selected {
    border-left-width: 8px;
    border-left-color: var(--color-primary);
}

.value-row--departed {
    opacity: 0.5;
}

.value-row--nested {
    margin-left: var(--space-m);
    background-color: var(--color-bg);
}

.action {
    margin-bottom: var(--space-xs);
}

.action__button {
    min-height: var(--touch-height);
    margin: 0;
    font-size: var(--font-m);
    color: var(--color-bg);
    background-color: var(--color-primary);
    border-width: 0;
    border-radius: var(--radius-s);
    white-space: normal;
}

.action__button:disabled {
    opacity: 0.4;
}

.action__detail {
    font-size: var(--font-s);
    color: var(--color-text-muted);
    white-space: normal;
    margin: 4px var(--space-xs) 0 var(--space-xs);
}

.result-card {
    margin-bottom: var(--space-s);
    padding: var(--space-s) var(--space-m);
    background-color: var(--color-surface-raised);
    border-radius: var(--radius-m);
    border-left-width: 8px;
    border-left-color: var(--color-good);
}

.result-card--failed {
    border-left-color: var(--color-bad);
}

.result-card__title {
    font-size: var(--font-l);
    color: var(--color-text);
    -unity-font-style: bold;
    white-space: normal;
}

.result-card__line {
    font-size: var(--font-m);
    color: var(--color-text);
    white-space: normal;
}

.result-card__close {
    height: var(--touch-height);
    margin: var(--space-s) 0 0 0;
    font-size: var(--font-m);
    color: var(--color-text);
    background-color: var(--color-surface);
    border-width: 0;
    border-radius: var(--radius-s);
}

.timeline-entry {
    border-left-width: 8px;
    border-left-color: var(--color-border);
}

.timeline-entry--birth,
.timeline-entry--relationship {
    border-left-color: var(--color-good);
}

.timeline-entry--education,
.timeline-entry--career {
    border-left-color: var(--color-primary);
}

.timeline-entry--loss,
.timeline-entry--scam,
.timeline-entry--death {
    border-left-color: var(--color-bad);
}

/* Task 17b: life plan */
.list-screen__warning {
    font-size: var(--font-s);
    color: var(--color-warning);
    white-space: normal;
    margin-bottom: var(--space-xs);
}

.activity {
    margin-bottom: var(--space-s);
}

.activity__effect {
    font-size: var(--font-s);
    color: var(--color-text-muted);
    margin-left: var(--space-s);
}

.activity__steps {
    flex-direction: row;
    margin-top: 4px;
}

.activity__step {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--touch-height);
    margin: 0 4px 0 0;
    font-size: var(--font-m);
    color: var(--color-text);
    background-color: var(--color-surface-raised);
    border-width: 0;
    border-radius: var(--radius-s);
}

.activity__step:disabled {
    opacity: 0.4;
}

/* Task 18: life summary, family tree, achievements */
.summary__line {
    font-size: var(--font-m);
    color: var(--color-text);
    white-space: normal;
    margin-bottom: var(--space-xs);
}

.summary__achievement {
    font-size: var(--font-m);
    color: var(--color-good);
    margin-bottom: 4px;
}

.value-row--locked {
    opacity: 0.5;
}

/* Task 16b: family status card on the dashboard */
.family-card {
    margin-bottom: var(--space-s);
}
