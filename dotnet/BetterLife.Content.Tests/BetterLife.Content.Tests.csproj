<Project Sdk="Microsoft.NET.Sdk">
  <!-- Validates the real /content folder: schemas, manifest completeness and a full pipeline load.
       dotnet-only: the schema validator library is not shipped with the game. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>BetterLife.Content.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BetterLife.Core.csproj" />
  </ItemGroup>
</Project>
