<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile-only check: builds the Core test sources the way Unity does (netstandard2.1 API profile and
    NUnit 3.5.0 from com.unity.ext.nunit 1.0.6, used by Unity Test Framework 1.1.33). The tests themselves run in
    BetterLife.Core.Tests with a newer NUnit; this project only fails the build when a test uses an API Unity lacks.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- Same name as the Unity test assembly, so Core's InternalsVisibleTo applies; output goes to its own bin folder. -->
    <AssemblyName>BetterLife.Core.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- NUnit 3.5.0 only ships .NET Framework builds; Unity references the same assembly. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../packages/com.betterlife.core/Tests/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="BetterLife.Core.csproj" />
  </ItemGroup>
</Project>
