<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity-free Core package outside Unity to enforce the pure C# rule. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>BetterLife.Core</RootNamespace>
    <AssemblyName>BetterLife.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../packages/com.betterlife.core/Runtime/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same library Unity ships as com.unity.nuget.newtonsoft-json. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
